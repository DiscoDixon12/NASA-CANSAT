CHANNELS = [17, 27, 22]  # gpio channels
MOTORS = [1, 2, 3]
def init_driver():   # initialises the driver 
    GPIO.setmode(GPIO.BCM)
    for pin in CHANNELS:
        GPIO.setup(pin, GPIO.OUT)
        GPIO.output(pin, GPIO.LOW)
 
